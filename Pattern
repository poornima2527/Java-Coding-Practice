public class Pattern {
    public static void main(String[] args) {
        int n = 4;
        int num = 1;
        for(int i = 1; i <= n; i++) {
            for(int j = 0; j < i; j++) {
                System.out.print(num+" ");
                num +=2;
            }
            System.out.println();
        }
    }
}