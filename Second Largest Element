public class Main {
    public static void main(String[] args) {

        int[] arr = {10, 25, 7, 45, 18};

        int max = arr[0];
        int second = arr[0];

        for (int i = 1; i < arr.length; i++) {

            if (arr[i] > max) {
                second = max;
                max = arr[i];
            } 
            else if (arr[i] > second && arr[i] != max) {
                second = arr[i];
            }
        }

        System.out.println("Second Largest = " + second);
    }
}
