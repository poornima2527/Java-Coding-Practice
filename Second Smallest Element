import java.util.*;
public class main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a[] = new int[n];
        for(int i=0; i<n; i++) {
            a[i] = sc.nextInt();
        }
        int m = a[0];
        int sm = a[0];
        for(int i=0;i<n;i++) {
            if(a[i] < m) {
                sm = m;
                m = a[i];
            }else if(a[i] < sm && a[i] != m){
                sm = a[i];
            }
                
            
        }
        System.out.println(sm);
    }
}
